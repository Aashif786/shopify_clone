{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@calcart/ui": ["../../packages/ui/src/index.ts"],
      "@calcart/tenant": ["../../packages/tenant/src/index.ts"],
      "@calcart/db": ["../../packages/db/src/index.ts"],
      "@calcart/types": ["../../packages/types/src/index.ts"],
      "@calcart/config": ["../../packages/config/src/index.ts"],
      "@calcart/carts": ["../../modules/carts/src/index.ts"],
      "@calcart/stores/landing-page": ["../../modules/stores/src/domain/landing-page.ts"],
      "@calcart/stores": ["../../modules/stores/src/index.ts"],
      "@calcart/products/combinations": ["../../modules/products/src/domain/combinations.ts"],
      "@calcart/products": ["../../modules/products/src/index.ts"],
      "@calcart/*": ["../../modules/*/src/index.ts", "../../packages/*/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
