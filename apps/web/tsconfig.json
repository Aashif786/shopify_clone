{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@shopify-clone/ui": ["../../packages/ui/src/index.ts"],
      "@shopify-clone/tenant": ["../../packages/tenant/src/index.ts"],
      "@shopify-clone/db": ["../../packages/db/src/index.ts"],
      "@shopify-clone/types": ["../../packages/types/src/index.ts"],
      "@shopify-clone/config": ["../../packages/config/src/index.ts"],
      "@shopify-clone/carts": ["../../modules/carts/src/index.ts"],
      "@shopify-clone/stores/landing-page": ["../../modules/stores/src/domain/landing-page.ts"],
      "@shopify-clone/stores": ["../../modules/stores/src/index.ts"],
      "@shopify-clone/products/combinations": ["../../modules/products/src/domain/combinations.ts"],
      "@shopify-clone/products": ["../../modules/products/src/index.ts"],
      "@shopify-clone/*": ["../../modules/*/src/index.ts", "../../packages/*/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
