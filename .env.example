# Application Configuration
NODE_ENV=development
APP_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Public Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (Note: docker-compose maps PostgreSQL container port 5432 to host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/calcart_dev

# Authentication Configuration
AUTH_SECRET=development_auth_secret_must_be_at_least_32_characters_long

# Upload limits. Values outside the safe range fall back to these defaults.
# SVG uploads are rejected. ZIP extraction also enforces these caps.
UPLOAD_MAX_IMAGE_BYTES=15728640
UPLOAD_MAX_ZIP_BYTES=52428800
UPLOAD_MAX_ZIP_ENTRIES=100
UPLOAD_MAX_ZIP_UNCOMPRESSED_BYTES=104857600
UPLOAD_MAX_ZIP_ENTRY_BYTES=15728640
UPLOAD_MAX_ZIP_RATIO=100

# Trusted proxy for client IP rate limits.
# none (default) ignores cf-connecting-ip, x-real-ip, and x-forwarded-for.
# forwarded:1 trusts the rightmost X-Forwarded-For hop appended by one reverse proxy.
# cloudflare trusts cf-connecting-ip only when the origin is reachable solely through Cloudflare.
# real-ip trusts X-Real-IP only when nginx overwrites it with $remote_addr.
TRUSTED_PROXY=none

# Worker Configuration
JOB_POLL_INTERVAL=5000
JOB_CONCURRENCY=4
PAYMENT_RECOVERY_ENABLED=true
PAYMENT_RECOVERY_POLL_INTERVAL=10000
PAYMENT_RECOVERY_BATCH_SIZE=50
PAYMENT_WEBHOOK_LEASE_TIMEOUT=60000

# Razorpay Configuration (Payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Transactional Email Configuration (Resend)
# Live email sending requires a Resend API key starting with 're_'
RESEND_API_KEY=
# Sender email address. Use 'Cal Cart <onboarding@resend.dev>' for testing, or your verified domain in production.
RESEND_FROM_EMAIL=Cal Cart <onboarding@resend.dev>
# Optional reply-to address
RESEND_REPLY_TO_EMAIL=
# Optional timeout in milliseconds (default: 8000)
RESEND_TIMEOUT_MS=8000


# Extra trusted origins for storefront images that are LINKED from elsewhere (a CDN, an
# object store, an imported catalogue). Merchant uploads are served first-party and need
# nothing here. Comma separated, https only, optionally one leading "*." label:
#   STOREFRONT_IMAGE_ORIGINS=https://cdn.example-shop.com,https://*.s3.ap-south-1.amazonaws.com
# Anything else (http:, bare "*", paths) is ignored with a warning. These origins feed both
# the Content-Security-Policy img-src and next/image remotePatterns.
STOREFRONT_IMAGE_ORIGINS=
