{
  "name": "@shopify-clone/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/migrate-cli.js",
    "migrate:status": "node dist/migrate-cli.js --status"
  },
  "dependencies": {
    "@shopify-clone/config": "workspace:*",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11"
  }
}
